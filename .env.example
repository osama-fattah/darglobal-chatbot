# Required: free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: comma-separated models to use instead of auto-discovered free models
OPENROUTER_MODELS=
# Optional: token that allows POST /api/refresh (re-scrape on demand)
ADMIN_TOKEN=
# Optional: re-scrape on startup when data is older than this (hours)
REFRESH_IF_OLDER_THAN_HOURS=24
